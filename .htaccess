# MediTick was renamed TimelyDoz on 2026-08-31 and its folder moved
# /meditick/ -> /timelydoz/. Keep these rules indefinitely: App Store Connect
# and Play Console listings may still point at the old privacy/support URLs,
# and so may anything already linked or indexed.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^meditick/?$      /timelydoz/  [R=301,L]
  RewriteRule ^meditick/(.*)$   /timelydoz/$1 [R=301,L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
